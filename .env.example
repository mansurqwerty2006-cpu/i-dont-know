TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
GROQ_API_KEY=put_your_groq_api_key_here
TAVILY_API_KEY=put_your_tavily_api_key_here
CLOUDFLARE_API_TOKEN=put_your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=put_your_cloudflare_account_id_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=put_your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=put_your_supabase_service_role_key_here
SUPABASE_DB_PASSWORD=put_your_database_password_here

# Default model checked against Groq docs in June 2026.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional tuning.
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1200
BOT_HISTORY_MESSAGES=20
BOT_FEW_SHOT_EXAMPLES=6
BOT_PROFILE_FILE=bot_profile.md
BOT_KNOWLEDGE_FILE=bot_knowledge.md
BOT_RECENT_DB_FILE=recent_db.md
BOT_EXAMPLES_FILE=training_examples.jsonl
BOT_MEMORY_FILE=data/chat_memory.json
BOT_GROUND_CHECK=true
BOT_GROUND_CHECK_MAX_TOKENS=220
BOT_MULTI_CHAIN_REASONING=true
BOT_MULTI_CHAIN_COUNT=3
BOT_MULTI_CHAIN_MAX_TOKENS=260
TAVILY_SEARCH_ENABLED=true
TAVILY_AUTO_SEARCH=true
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
CLOUDFLARE_IMAGE_WIDTH=1024
CLOUDFLARE_IMAGE_HEIGHT=1024
CLOUDFLARE_IMAGE_NUM_STEPS=20
CLOUDFLARE_IMAGE_GUIDANCE=7.5
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
RAG_MATCH_COUNT=5
RAG_SIMILARITY_THRESHOLD=0.25

# Bot personality / behavior.
BOT_SYSTEM_PROMPT=Ты полезный ИИ-ассистент в Telegram. Отвечай ясно, по делу и на языке пользователя.
